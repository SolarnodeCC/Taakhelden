# Local development only. Copy this file to `.dev.vars`; never use these values in production.
# Production: plain vars live in wrangler.toml `[vars]`; secrets are synced from the GitHub
# Environment `production` by deploy-prod.yml (or `npx wrangler secret put <NAME>`).
# See docs/cloudflare-bindings-audit.md.

# Required for auth (token issue/verify). Without it, register/login that mint JWTs return 500.
JWT_SECRET=local-dev-secret-change-me

# Optional dedicated HMAC for photo/export signed URLs. When unset, JWT_SECRET is used.
# Production should set HMAC_SECRET separately (see docs/cloudflare-bindings-audit.md).
HMAC_SECRET=

# Turnstile — leave empty locally; verifyTurnstile skips when unset (accepts any token).
TURNSTILE_SECRET=

# APNs signing key material (optional locally — push is a no-op when empty).
# APPLE_CLIENT_ID / APPLE_BUNDLE_ID / APNS_ENV come from wrangler.toml [vars] in deploy;
# override here for local Apple Sign-in / push testing if needed.
APPLE_CLIENT_ID=com.taakhelden.web
APPLE_BUNDLE_ID=nl.taakhelden.app
APNS_ENV=sandbox
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# Co-parent invite email (Resend). Without these, send is a no-op.
EMAIL_API_KEY=
EMAIL_FROM=

# Base URL of the parent dashboard (invite links). Optional; production default is in wrangler [vars].
APP_BASE_URL=http://localhost:3000
