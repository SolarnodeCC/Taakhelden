<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy rule 5: nothing from this app leaves the device through backup or transfer.
  Sessions, the hashed child PIN and the offline mutation queue are all device-bound;
  restoring them onto another device would move a child's session with them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
