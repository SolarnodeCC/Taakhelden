<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Since API 28 cleartext HTTP is blocked by default, which silently broke the local-dev
  workflow the README documents (`TAAKHELDEN_API_BASE_URL=http://10.0.2.2:8787/v1`
  against `wrangler dev`). This allows cleartext for the loopback hosts only — never for
  the production Worker, and this file does not exist in the release source set at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Host loopback as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Device loopback, for `adb reverse tcp:8787 tcp:8787`. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
