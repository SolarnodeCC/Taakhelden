<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay: permits cleartext to the loopback hosts so a debug build can talk
  to a local `wrangler dev`. Release builds never merge this file, so production traffic
  stays HTTPS-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
