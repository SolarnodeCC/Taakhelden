# Cloudflare Turnstile site key for parent registration.
# Leave unset locally — the form sends "dev-bypass" and the Worker accepts any
# token when TURNSTILE_SECRET is unset on the API side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Worker base URL (BFF proxy target). Must include the `/v1` prefix.
# Defaults to http://localhost:8787/v1. On Cloudflare Workers this comes from
# wrangler.jsonc `vars.API_BASE_URL` (read via getCloudflareContext), not from
# a NEXT_PUBLIC_ variable.
# API_BASE_URL=http://localhost:8787/v1
