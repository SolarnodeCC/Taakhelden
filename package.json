{
  "name": "taakhelden",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "openapi:generate": "npm run openapi:generate -w packages/shared",
    "openapi:check": "npm run openapi:check -w packages/shared"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "11.1.0"
    },
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.65.0"
  }
}
